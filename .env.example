# MQTT
MQTT_SERVER=127.0.0.1
MQTT_TOPIC=uwb/distances

# Room geometry (meters)
ROOM_WIDTH_M=6.0
ROOM_DEPTH_M=6.0

# Fall thresholds
Y_HIGH=1.2
Y_LOW=0.45
FALL_DISTANCE_DROP_M=0.35
FALL_HEIGHT_DROP_M=0.4
MOTIONLESS_SECONDS=2.5
MOTIONLESS_RADIUS_M=0.15
FLOOR_ANCHOR_IDX=0
CEILING_ANCHOR_IDX=3

# Optional Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
